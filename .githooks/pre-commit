#!/usr/bin/env bash
# Blocks commits containing secrets. Installed by setup.sh via core.hooksPath.
set -euo pipefail

staged="$(git diff --cached --name-only)"
if printf '%s\n' "$staged" | grep -E '(^|/)\.env(\..+)?$' | grep -vqE '\.env\.example$'; then
  echo "✗ Blocked: a .env file is staged. Unstage it: git restore --staged .env"
  exit 1
fi

command -v gitleaks >/dev/null || { echo "✗ gitleaks not installed. Run ./setup.sh"; exit 1; }

if gitleaks git --help >/dev/null 2>&1; then
  gitleaks git --pre-commit --staged --redact --verbose --no-banner
else
  gitleaks protect --staged --redact --verbose --no-banner
fi
