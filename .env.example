# Copy to .env (setup.sh does this). .env is gitignored and blocked by the pre-commit hook.
PROMPTFOO_DISABLE_TELEMETRY=1

# API keys: not needed until Week 3. See docs/SETUP.md step 4 for spend caps BEFORE adding keys.
# Keys stay last in this file: gitleaks reads an empty value together with the next line
# and flags it as a false positive.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
